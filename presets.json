{
  "proof_of_income": {
    "label": "Proof of Income",
    "keep": ["name", "salary_amount", "employer_name", "pay_period", "designation",
             "remarks"],
    "redact": ["account_number", "address", "phone_number", "bank_ifsc", "pan_number",
               "aadhaar_number", "other_deductions", "pf_number", "signature", "photo"]
  },
  "id_verification": {
    "label": "ID Verification Only",
    "keep": ["name", "photo", "id_number_last4"],
    "redact": ["full_id_number", "address", "date_of_birth", "phone_number",
               "father_name", "category", "signature"]
  },
  "proof_of_address": {
    "label": "Proof of Address",
    "keep": ["name", "address"],
    "redact": ["id_number", "phone_number", "photo", "date_of_birth", "signature"]
  },
  "education_proof": {
    "label": "Education Proof",
    "keep": ["name", "institution_name", "qualification", "cgpa_or_marks", "year"],
    "redact": ["roll_number", "category", "father_name", "date_of_birth", "address", "photo"]
  }
}
